{
  "expo": {
    "name": "Burma90",
    "slug": "365Maung",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/burma90-app-icon.png",
    "scheme": "burma90",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#27A060",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#27A060"
      }
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/burma90-app-icon.png",
      "backgroundColor": "#ffffff",
      "userInterfaceStyle": "light",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#27A060",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#27A060"
        }
      }
    },
    "android": {
      "package": "com.dobbieq.maung365",
      "versionCode": 1,
      "backgroundColor": "#ffffff",
      "icon": "./assets/images/android-icon-foreground.png",
      "adaptiveIcon": {
        "backgroundColor": "#002313",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-foreground.png"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#27A060",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#27A060"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "userInterfaceStyle": "light"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/burma90-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#27A060",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#27A060"
          },
          "android": {
            "backgroundColor": "#27A060",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "dark": {
              "image": "./assets/images/splash-icon.png",
              "backgroundColor": "#27A060"
            }
          },
          "ios": {
            "backgroundColor": "#27A060",
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "dark": {
              "image": "./assets/images/splash-icon.png",
              "backgroundColor": "#27A060"
            }
          }
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true,
            "networkInspector": false,
            "packagingOptions": {
              "exclude": ["lib/x86/**", "lib/x86_64/**"]
            },
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class expo.modules.** { *; }"
          }
        }
      ],
      "./plugins/with-light-splash.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d35dc874-2242-4d5d-9474-60aacdd14430"
      }
    },
    "owner": "dobbieq"
  }
}
